# Copy to .env (which Git ignores) and fill in. Used by docker-compose.yml.

# The model: any OpenAI-compatible endpoint.
AGI_MODEL=gpt-4o-mini
OPENAI_API_KEY=
# OPENAI_BASE_URL=http://host.docker.internal:11434/v1

# Grafana's first admin password.
GRAFANA_ADMIN_PASSWORD=

# The API token is not set here: put it in secrets/agi_api_token.txt
#   python -c "import secrets; print(secrets.token_urlsafe(32))" > secrets/agi_api_token.txt
